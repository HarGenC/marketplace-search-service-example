# Локальный запуск: сервисы в docker-compose проброшены на хост.
# Дефолты в src/settings.py рассчитаны на docker-сеть marketplace,
# поэтому без этого файла make migrate / make run не найдут PostgreSQL.

POSTGRES_DATABASE_NAME=search_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_ADS=ads
KAFKA_CONSUMER_GROUP=search-service

AD_SERVICE_URL=http://localhost:8002

# 8000 и 8002 заняты auth-service и ad-service
API_HOST=0.0.0.0
API_PORT=8003
